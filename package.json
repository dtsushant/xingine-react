{
  "name": "xingine-react",
  "version": "1.0.8",
  "description": "A xingine for react",
  "main": "dist/index.js",
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsc --project tsconfig.json && tsc-alias",
    "build:dev": "tsc --project tsconfig.dev.json && tsc-alias",
    "build:watch": "tsc --project tsconfig.json --watch",
    "watch": "concurrently \"npm run build:watch\" \"nodemon --watch dist --exec 'npm run push'\"",
    "dev:demo": "start-dev.bat",
    "dev:demo-direct": "start-demo-direct.bat",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ui": "jest --testPathPattern=component",
    "test:integration": "jest --testPathPattern=integration",
    "test:context": "jest --testPathPattern=context",
    "test:verbose": "jest --verbose",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "demo:ui": "echo 'Open demo/ui-test.html in your browser for interactive UI demo'",
    "demo:serve": "npx http-server demo -p 8080 -o",
    "test:tsx": "echo 'Open src/test/tsx-ui-test.html in your browser for TSX-based UI test'",
    "test:tsx:serve": "npx http-server src/test -p 3001 -o tsx-ui-test.html",
    "prepare": "npm run build",
    "push": "yalc push --changed && echo 'Package pushed to linked projects'",
    "push:force": "yalc push --changed --force && node trigger-reload.js",
    "yalc:dev": "npm run clean && npm run build && npm run push",
    "yalc:dev-with-sourcemaps": "npm run clean && npm run build:dev && npm run push"
  },
  "keywords": [
    "typescript",
    "library",
    "decoder",
    "react",
    "validation"
  ],
  "author": "Sushant Pandey <dtsushant@gmail.com>",
  "license": "GNU",
  "repository": {
    "type": "git",
    "url": "https://github.com/dtsushant/xingine-react.git"
  },
  "bugs": {
    "url": "https://github.com/dtsushant/xingine-react/issues"
  },
  "homepage": "https://github.com/dtsushant/xingine-react#readme",
  "peerDependencies": {
    "@ant-design/icons": "^6.0.0",
    "@hqoss/monads": "^0.5.0",
    "antd": "^5.24.5",
    "axios": "^1.8.4",
    "decoders": "^2.7.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.4.0",
    "recharts": "^2.15.3",
    "use-debounce": "^10.0.4",
    "xingine": "file:../xingine"
  },
  "devDependencies": {
    "@ant-design/icons": "^6.0.0",
    "@hqoss/monads": "^0.5.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.0.10",
    "antd": "^5.24.5",
    "axios": "^1.8.4",
    "concurrently": "^8.2.2",
    "decoders": "^2.7.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.0.5",
    "nodemon": "^3.1.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.4.0",
    "recharts": "^2.15.3",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.3.0",
    "tsc-alias": "^1.8.2",
    "typescript": "^5.0.0",
    "use-debounce": "^10.0.4",
    "xingine": "file:../xingine"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts",
      "tsx"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.(test|spec)\\.(ts|tsx)$",
    "transform": {
      "^.+\\.(t|j)sx?$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s",
      "src/**/*.(t|j)sx",
      "!src/**/*.d.ts",
      "!**/dist/**"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/dist/"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/dist/"
    ],
    "coverageDirectory": "coverage",
    "testEnvironment": "jsdom",
    "preset": "ts-jest",
    "setupFilesAfterEnv": [
      "<rootDir>/src/test/setup.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "testEnvironmentOptions": {
      "url": "http://localhost"
    }
  },
  "engines": {
    "node": ">=14"
  },
  "publishConfig": {
    "access": "public"
  }
}
